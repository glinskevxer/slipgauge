{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "rootDir": "..",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@registry/*": ["src/*"],
      "*": ["node_modules/*", "node_modules/@types/*"]
    }
  },
  "include": ["src/**/*.ts", "../tests/backend/**/*.ts"]
}
