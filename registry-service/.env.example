# Copy to .env.local for a local run. The service refuses to start without a
# signing key, so this is the one value you cannot skip.

REGISTRY_JWT_SECRET=local-development-signing-key-not-for-any-real-deployment

REGISTRY_DB_URL=postgres://localhost:5432/slipgauge
REGISTRY_DB_USER=slipgauge
REGISTRY_DB_PASSWORD=slipgauge

LAB_NAME=Slipgauge Metrology
LAB_ACCREDITATION_REF=LOCAL-0000
LAB_TIME_ZONE=Europe/London
LAB_ASSET_TAG_PREFIX=SG
LAB_ASSET_TAG_WIDTH=6

REGISTRY_ALLOWED_ORIGINS=http://localhost:4200

# The four numbers the interval procedure works to. Written down here because
# an assessment asks what they are and where they are recorded.
REGISTRY_INTERVAL_PASSES=2
REGISTRY_INTERVAL_EXTENSION_STEP=0.15
REGISTRY_INTERVAL_FAILURE_FACTOR=0.5
REGISTRY_INTERVAL_DRIFT_BRAKE=0.7

# Loads a demo laboratory into an empty register: a schedule of accreditation,
# a week of room readings with one afternoon that went wrong, and three
# customers with a job each. Never true anywhere real.
REGISTRY_DEMO_ESTATE=false

# Bcrypt work factor. Ten is the floor for anything that is not a test.
REGISTRY_BCRYPT_ROUNDS=12

# The room logger poller, which runs as its own process. Left blank here
# because a laptop cannot see the loggers.
REGISTRY_LOGGER_HOST=
REGISTRY_LOGGER_TOKEN=
REGISTRY_LOGGER_ROOMS=HARLOW-DIM=TINYTAG-4471,CREWE-TOOL=TINYTAG-4472
