# Copy to .env.local for a local run. The service refuses to start without a
# signing key, so this is the one value you cannot skip.

REGISTRY_JWT_SECRET=local-development-signing-key-not-for-any-real-deployment

REGISTRY_DB_URL=postgres://localhost:5432/slipgauge
REGISTRY_DB_USER=slipgauge
REGISTRY_DB_PASSWORD=slipgauge

LAB_NAME=Slipgauge Metrology
LAB_ACCREDITATION_REF=LOCAL-0000
LAB_TIME_ZONE=Europe/London
LAB_ASSET_TAG_PREFIX=SG
LAB_ASSET_TAG_WIDTH=6

REGISTRY_ALLOWED_ORIGINS=http://localhost:4200
